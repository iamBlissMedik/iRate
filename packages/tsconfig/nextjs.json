{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "iRate Next.js app",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "module": "esnext",
    "plugins": [{ "name": "next" }]
  }
}
