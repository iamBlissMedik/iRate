# iRate wallet app — copy to .env.local
#
# Server-only (read by the BFF). Never prefix these with NEXT_PUBLIC_: the
# backend URL and session cookies must not be exposed to the browser.

# The iRate API, including the version prefix.
IRATE_API_BASE_URL=http://localhost:8000/api/v1

# Optional overrides (defaults shown).
# IRATE_ACCESS_COOKIE=irate_at
# IRATE_REFRESH_COOKIE=irate_rt
# IRATE_BACKEND_REFRESH_COOKIE=refreshToken   # cookie name the API expects on /auth/refresh
# IRATE_ACCESS_MAX_AGE=900                    # seconds
# IRATE_REFRESH_MAX_AGE=604800                # seconds
